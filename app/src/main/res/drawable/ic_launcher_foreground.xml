    <path
        android:fillColor="#FF4E7189"
        android:pathData="M24,50C36,41 46,31 54,31C62,31 72,41 84,50L79,55C69,48 61,38 54,38C47,38 39,48 29,55Z" />

    <!-- 落日，落在檐下 -->
    <path
        android:fillColor="#FFD88C62"
        android:pathData="M46.5,49A7.5,7.5 0 1,0 61.5,49A7.5,7.5 0 1,0 46.5,49Z" />

    <!-- 两道水面 -->
    <path
        android:fillColor="#FFFBFCFD"
        android:pathData="M26,63.5h56v3.4h-56zM35,71h38v3h-38z" />
</vector>
